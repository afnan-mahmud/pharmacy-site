# Copy to .env.local and fill in real values. Both are required to boot.

# MongoDB Atlas connection string. The free M0 tier is enough for this system.
MONGODB_URI=

# Signing key for session cookies. Must be at least 32 random characters —
# the app refuses to start otherwise. Generate one with:
#   openssl rand -base64 36
# Never commit the real value, and never reuse this key across environments.
SESSION_SECRET=

# Password for the initial admin account, read once by `npm run seed`.
SEED_ADMIN_PASSWORD=
